{
  "name": "Tedbirge® WebOS",
  "short_name": "Tedbirge",
  "description": "Tedbirge® WebOS: taşıyıcı-bağımsız, sıfır-bilgi P2P ağ işletim sistemi. Uçtan uca şifreli sohbet, görüşme ve veri taşıma.",
  "start_url": "/chat",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#f8fafc",
  "background_color": "#f8fafc",
  "lang": "tr",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "social"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Sohbet", "url": "/chat" },
    { "name": "Saha erişimi", "url": "/saha" },
    { "name": "Canlı demo", "url": "/demo" },
    { "name": "Pilot panosu", "url": "/pilot-panosu" }
  ]
}
