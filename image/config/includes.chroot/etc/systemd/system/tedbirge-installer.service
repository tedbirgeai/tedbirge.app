[Unit]
Description=Tedbirge etkileşimli disk kurulumu
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
ConditionKernelCommandLine=tedbirge.install=1

[Service]
Type=idle
Environment=DEBIAN_FRONTEND=noninteractive
Environment=APT_LISTCHANGES_FRONTEND=none
Environment=TERM=linux
Environment=NCURSES_NO_UTF8_ACS=1
# Kurulum bittiginde ya da iptal edildiginde ekran bos kalmasin: kullanici
# her durumda okunabilir bir kabuga duser (bos ekran + yanip sonen imlec yok).
ExecStartPre=-/bin/setfont /usr/share/consolefonts/Lat15-Terminus16.psf.gz
ExecStart=/opt/tedbirge/oturum.sh
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Menu ya da canli masaustu suresiz acik kalabilir; sadece beklenmedik
# cokmelerde yeniden baslatilir.
Restart=on-failure
RestartSec=1
TimeoutStopSec=30


[Install]
WantedBy=multi-user.target
