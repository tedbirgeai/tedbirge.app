[Unit]
Description=Tedbirge WebOS kiosk arayuzu
After=nginx.service systemd-user-sessions.service
Wants=nginx.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionKernelCommandLine=!tedbirge.install=1
ConditionKernelCommandLine=!tedbirge.autoinstall=1

[Service]
Type=simple
ExecStart=/usr/bin/xinit /opt/tedbirge/kiosk.sh -- :0 vt1 -nocursor -keeptty
Restart=always
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1

[Install]
WantedBy=graphical.target
