ILERLE 75 "Acilis diski hazirlaniyor (initramfs) — birkac dakika surebilir"
uzun_adim "Acilis diski guncelleniyor" timeout 1800s \
  chroot "$KOK" "${CHROOT_ENV[@]}" \
  update-initramfs -u -k all < /dev/null \
  || hata "Acilis diski (initramfs) uretilemedi."
ILERLE 90 "Acilis menusu olusturuluyor"
uzun_adim "Acilis menusu olusturuluyor" timeout 600s chroot "$KOK" "${CHROOT_ENV[@]}" \
  update-grub < /dev/null \
  || hata "Acilis menusu (grub.cfg) uretilemedi."
# Hizmet engelleyici yalnizca kurulum surecine ozeldir.
rm -f "$KOK/usr/sbin/policy-rc.d"


