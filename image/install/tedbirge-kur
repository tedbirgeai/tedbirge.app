#!/bin/bash
# Tedbirge® WebOS — kalici disk kurulumu (Debian canli sistem uzerinde).
# ------------------------------------------------------------------
# Model: canli sistemin ONCEDEN PISIRILMIS koku (squashfs) hedefe acilir.
# Hedef bilgisayarda paket kurulumu YAPILMAZ; internet gerekmez.
set -uo pipefail

export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
export UCF_FORCE_CONFFOLD=1
export INITRD=Yes
export GRUB_DISABLE_OS_PROBER=true
export UDEV_DISABLE=1

# Uzun disk islemlerini SABIT bir sureyle degil, PROSES AKTIVITESI ile denetler.
# Islem CPU zamani veya diske yazma sayaci ilerledigi surece asla kesilmez;
# yalnizca gercekten kilitlenirse (belirlenen sure boyunca hicbir ilerleme yok)
# durdurulur. Boylece yavas ama saglikli CI/emulasyon ortamlari cezalandirilmaz.
STALL="${TEDBIRGE_STALL_SECONDS:-300}"

HEDEF_DISK=""   # ilerleme olcumu icin: kurulum diskinin cekirdek adi (ornek: sda)

surec_agaci() { # pid -> pid + tum alt/torun pid'leri
  local pid="$1" c
  printf '%s\n' "$pid"
  for c in $(pgrep -P "$pid" 2>/dev/null); do surec_agaci "$c"; done
}

disk_yazma() { # kurulum diskinin toplam yazma sektoru (varsa)
  [ -n "$HEDEF_DISK" ] || { printf '0'; return; }
  awk '{print $7+0}' "/sys/block/$HEDEF_DISK/stat" 2>/dev/null || printf '0'
}

# ONEMLI: update-initramfs/grub gibi araclar isi ALT SURECLERE yaptirir ve
# kendileri sigsuspend ile bekler. Yalniz ana surece bakan bir olcum, saglikli
# calisan kurulumu "kilitlendi" sanip oldururdu (CI'de tam olarak bu yasandi).
# Bu yuzden ilerleme TUM SUREC AGACI + hedef diskin yazma sayaci uzerinden olculur.
surec_ilerlemesi() { # pid -> "cpu_tick io_bayt disk_sektor"
  local pid="$1" p cpu=0 io=0 v
  for p in $(surec_agaci "$pid"); do
    v=$(awk '{print $14+$15+$16+$17}' "/proc/$p/stat" 2>/dev/null || echo 0)
    cpu=$((cpu + ${v:-0}))
    v=$(awk '/^(read|write)_bytes:/ {t+=$2} END{print t+0}' "/proc/$p/io" 2>/dev/null || echo 0)
    io=$((io + ${v:-0}))
  done
  printf '%s %s %s' "$cpu" "$io" "$(disk_yazma)"
}

uzun_adim() { # ad, komut...
  local ad="$1" pid baslangic simdi rc onceki suanki sessiz=0 wchan cocuk
  shift
  echo "-- $ad (kilitlenme denetimi: ${STALL}s ilerlemesizlik)"
  # Girdi beklentisi tumden kapatilir: chroot icindeki hicbir arac soru sorup
  # sessizce bekleyemez (kilitlenmelerin bilinen kok nedeni).
  stdbuf -oL -eL "$@" < /dev/null &
  pid=$!; baslangic=$(date +%s); onceki=$(surec_ilerlemesi "$pid")
  while kill -0 "$pid" 2>/dev/null; do
    sleep 15
    kill -0 "$pid" 2>/dev/null || break
    simdi=$(date +%s)
    suanki=$(surec_ilerlemesi "$pid")
    if [ "$suanki" = "$onceki" ]; then
      sessiz=$((sessiz + 15))
    else
      sessiz=0; onceki="$suanki"
    fi
    # Tanilama: surec hangi cekirdek cagrisinda bekliyor, alt sureci var mi?
    wchan=$(cat "/proc/$pid/wchan" 2>/dev/null || true)
    cocuk=$(pgrep -P "$pid" 2>/dev/null | head -3 | tr '\n' ' ')
    echo "... $ad suruyor ($((simdi - baslangic))s, ilerlemesiz ${sessiz}s, beklenen: ${wchan:-?}, alt surec: ${cocuk:-yok}, olcum: $suanki)"
    if [ -n "$GAUGE_PID" ]; then
      printf 'XXX\n%s\n%s\nXXX\n' "$ILERLE_YUZDE" "$ILERLE_METNI — $((simdi - baslangic)) saniyedir devam ediyor. Bilgisayari kapatmayin." >&3 2>/dev/null || true
    fi
    if [ "$sessiz" -ge "$STALL" ]; then
      echo "! $ad ${STALL}s boyunca hicbir ilerleme kaydetmedi; kilitlendi." >&2
      # Gercek kilitlenmede kok neden: hangi alt surec nerede bekliyor?
      for p in $(surec_agaci "$pid"); do
        echo "   surec $p: $(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | cut -c1-120) [wchan: $(cat "/proc/$p/wchan" 2>/dev/null)]" >&2
      done
      tail -20 "$KOK/var/log/initramfs-tools.log" 2>/dev/null >&2 || true
      kill -TERM "$pid" 2>/dev/null
      sleep 5
      kill -KILL "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      return 125
    fi
  done
  wait "$pid"; rc=$?
  return "$rc"
}


# chroot icinde calisan tum komutlara verilen ortak ortam: kullanici girdisi
# beklenmesi tumden engellenir, hizmet baslatma tetikleyicileri susturulur.
CHROOT_ENV=(env
  DEBIAN_FRONTEND=noninteractive
  APT_LISTCHANGES_FRONTEND=none
  UCF_FORCE_CONFFOLD=1
  GRUB_DISABLE_OS_PROBER=true
  UDEV_DISABLE=1
  INITRD=Yes
  TERM=dumb
  HOME=/root
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
)


MIN_BAYT=$((8 * 1024 * 1024 * 1024))
# Gozetimsiz kurulum: cekirdek satirinda tedbirge.autoinstall=1 varsa veya
# TEDBIRGE_AUTO=1 verilmisse soru sorulmaz (CI kurulum testi bunu kullanir).
# OTO_KAYNAK, gozetimsiz kurulumun acilis menusunden mi (gercek kullanici) yoksa
# ortam degiskeninden mi (CI) geldigini ayirir: kullanicida pencereli ilerleme
# ekrani acik kalir, CI'de eskisi gibi duz metin akisi kullanilir.
OTO="${TEDBIRGE_AUTO:-0}"
OTO_KAYNAK=""
if grep -q "tedbirge.autoinstall=1" /proc/cmdline 2>/dev/null; then
  OTO=1; OTO_KAYNAK="acilis"
fi
METIN=0
for a in "$@"; do
  case "$a" in
    --metin|--text) METIN=1 ;;
    --oto|--auto)   OTO=1 ;;
  esac
done
SQUASH="/run/live/medium/live/filesystem.squashfs"
LOG="/var/log/tedbirge/kurulum.log"
mkdir -p "$(dirname "$LOG")"

# ------------------------------------------------------ arayuz kipi secimi
# Pencereli sihirbaz gercek bir kullanici oturumunda acilir. Acilis menusunden
# baslatilan sifir-dokunuslu kurulumda da pencere acik kalir; boylece hicbir
# asamada bos/siyah ekran gorulmez. CI (TEDBIRGE_AUTO) duz metinle calisir.
GUI=0
if [ "$METIN" != "1" ] && [ -t 0 ] \
   && { [ "$OTO" != "1" ] || [ "$OTO_KAYNAK" = "acilis" ]; } \
   && command -v whiptail >/dev/null 2>&1 && [ -e /dev/tty ]; then
  GUI=1
fi

# Konsol fare destegi: kurulum ekranlari klavyenin yani sira fare ile de
# kullanilabilsin. gpm yoksa kurulum klavyeyle sorunsuz devam eder.
if [ "$GUI" = "1" ] && command -v gpm >/dev/null 2>&1; then
  pgrep -x gpm >/dev/null 2>&1 || gpm -m /dev/input/mice -t exps2 >/dev/null 2>&1 || true
fi

BT="Tedbirge(R) WebOS — Kurulum Yardimcisi"
GAUGE_PID=""
FIFO=""
ILERLE_YUZDE=0
ILERLE_METNI="Kurulum baslatiliyor"
YIKICI_ISLEM=0
HATA_KODU="KUR-001"

if [ "$GUI" = "1" ]; then
  # Ekran temiz kalsin: tum teknik cikti yalnizca kayit dosyasina akar.
  exec >>"$LOG" 2>&1
else
  exec > >(tee -a "$LOG") 2>&1
fi

# whiptail pencereleri her zaman gercek konsola cizilir. GUI kipinde stdout ve
# stderr kayit dosyasina yonlendirildigi icin her pencere acikca /dev/tty'ye
# cizilir ve klavye girdisi de /dev/tty'den okunur.
p_mesaj() { # baslik, metin
  whiptail --backtitle "$BT" --title "$1" --msgbox "$2" 18 74 >/dev/tty 2>&1 </dev/tty
}
p_soru() { # baslik, metin  -> 0 = evet
  whiptail --backtitle "$BT" --title "$1" --yesno "$2" 18 74 \
    --yes-button "Evet, devam et" --no-button "Hayir, iptal" >/dev/tty 2>&1 </dev/tty
}
p_bilgi() { # baslik, metin (ileri/iptal)
  whiptail --backtitle "$BT" --title "$1" --yesno "$2" 20 74 \
    --yes-button "Ileri" --no-button "Iptal" >/dev/tty 2>&1 </dev/tty
}
p_menu() { # baslik, metin, satirlar...  -> secim stdout
  local b="$1" m="$2"; shift 2
  # Pencere /dev/tty'ye cizilir, secilen deger fd4 uzerinden stdout'a doner.
  # (fd3 ilerleme cubugu FIFO'su icin ayrilmistir.)
  whiptail --backtitle "$BT" --title "$b" --menu "$m" 20 74 8 "$@" \
    4>&1 1>/dev/tty 2>&4 </dev/tty
}


gauge_baslat() {
  [ "$GUI" = "1" ] || return 0
  FIFO=$(mktemp -u /tmp/tbg-gauge.XXXXXX)
  mkfifo "$FIFO"
  whiptail --backtitle "$BT" --title "Kurulum suruyor" \
    --gauge "Hazirlaniyor..." 10 74 0 < "$FIFO" >/dev/tty 2>&1 &
  GAUGE_PID=$!
  exec 3>"$FIFO"
}
gauge_kapat() {
  [ -n "$GAUGE_PID" ] || return 0
  exec 3>&- 2>/dev/null
  wait "$GAUGE_PID" 2>/dev/null
  GAUGE_PID=""
  [ -n "$FIFO" ] && rm -f "$FIFO"
}
ILERLE() { # yuzde, aciklama
  ILERLE_YUZDE="$1"
  ILERLE_METNI="$2"
  echo ""; echo "== [%$1] $2 =="
  [ -n "$GAUGE_PID" ] || return 0
  printf 'XXX\n%s\n%s\nXXX\n' "$1" "$2 — Kurulum devam ediyor, bilgisayari kapatmayin." >&3 2>/dev/null || true
}

hata() {
  echo ""; echo "! $*" >&2
  if [ "${OTO:-0}" = "1" ]; then
    # /dev/console cogu kez ttyS0'a baglidir; ayni satiri iki kez yazmamak
    # icin aygitlarin gercek kimligi karsilastirilir.
    local yazilan="" t kimlik
    for t in /dev/console /dev/ttyS0; do
      kimlik=$(stat -Lc '%t:%T' "$t" 2>/dev/null || echo "$t")
      case " $yazilan " in *" $kimlik "*) continue ;; esac
      yazilan="$yazilan $kimlik"
      printf 'TEDBIRGE_INSTALL_FAIL %s\n' "$*" > "$t" 2>/dev/null
    done
  fi
  if [ "$GUI" = "1" ]; then
    gauge_kapat
    if [ "$YIKICI_ISLEM" = "1" ]; then
      DURUM="Disk hazirlama baslamisti. Kurucu guvenli biçimde durduruldu; diski yeniden kurmadan once bilgisayari kapatmayin."
    else
      DURUM="Diskinizde kalici bir degisiklik yapilmadi."
    fi
    p_mesaj "Kurulum durduruldu" \
"Hata kodu: $HATA_KODU

$*

$DURUM

Ne yapabilirsiniz:
 * Acilacak menuden kurulumu yeniden deneyin.
 * Baska bir disk secin ya da disk kablosunu yeniden takin.
 * Ayrintili kayit: $LOG

Devam etmek icin Enter'a basin."
  fi
  exit 1
}

baslik() { echo ""; echo "== $* =="; }


KOK=/mnt/tedbirge
P1=""; P2=""; P3=""; BAGLI=0
temizle() {
  set +e
  # Hizmet engelleyici her durumda kaldirilir; kurulan sistemde kalmamalidir.
  [ -n "$KOK" ] && rm -f "$KOK/usr/sbin/policy-rc.d" 2>/dev/null
  if [ "$BAGLI" = "1" ]; then
    [ -d "$KOK/var/log/tedbirge" ] && cp "$LOG" "$KOK/var/log/tedbirge/kurulum.log" 2>/dev/null
    for d in run sys proc dev/pts dev; do mountpoint -q "$KOK/$d" && umount -l "$KOK/$d"; done
    [ -n "$P1" ] && mountpoint -q "$KOK/boot/efi" && umount -l "$KOK/boot/efi"
    mountpoint -q "$KOK" && umount -l "$KOK"
  fi
}
trap temizle EXIT INT TERM

[ "$(id -u)" = "0" ] || hata "Bu araci yonetici olarak calistirin: sudo tedbirge-kur"

if [ "$GUI" != "1" ]; then
  clear 2>/dev/null || true
  echo "==============================================="
  echo "   Tedbirge(R) WebOS — Diske Kurulum"
  echo "==============================================="
  echo ""
  echo "Bu islem secilen diskteki TUM VERIYI SILER."
  echo ""
fi

# --------------------------------------------------------- kaynak dogrulama
if [ ! -s "$SQUASH" ]; then
  SQUASH=$(find /run/live/medium /lib/live/mount/medium /cdrom -name 'filesystem.squashfs' 2>/dev/null | head -1)
fi
[ -s "$SQUASH" ] || hata "Sistem imaji bulunamadi. USB bellegi cikarmadan tekrar deneyin."
command -v unsquashfs >/dev/null 2>&1 || hata "unsquashfs bulunamadi."

# UEFI mi BIOS mu?
TEST_MOD=$(sed -n 's/.*tedbirge.install-mode=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
if [ "$OTO" = "1" ] && [ "$TEST_MOD" = "uefi" ]; then
  MOD="UEFI"
elif [ -d /sys/firmware/efi ]; then
  MOD="UEFI"
else
  MOD="BIOS"
fi
echo "Acilis kipi: $MOD"

# ------------------------------------------------------- 1/6 hos geldiniz
if [ "$GUI" = "1" ] && [ "$OTO" = "1" ]; then
  # Sifir-dokunuslu kurulum: soru sorulmaz, ancak kullanici ne oldugunu gorur.
  whiptail --backtitle "$BT" --title "Otomatik kurulum baslatiliyor" \
    --infobox "Tedbirge(R) WebOS otomatik kurulum kipinde baslatildi.

 * Uygun disk kendiliginden secilir ve tamamen silinir.
 * Bolumleme, bicimlendirme ve acilis kurulumu soru sorulmadan yapilir.
 * Her adim bu ekranda yuzde ve gecen sureyle gosterilir.

Vazgecmek icin bilgisayari simdi kapatin.
Kurulum 10 saniye icinde basliyor..." 14 74 >/dev/tty 2>&1 </dev/tty
  sleep 10
elif [ "$GUI" = "1" ]; then
  p_bilgi "Adim 1/6 — Hos geldiniz" \
"Tedbirge(R) WebOS bilgisayarinizin diskine kalici olarak kurulacak.

Ne olacak:
 * Sececeginiz disk tamamen silinip yeniden bolumlenir.
 * Hazir sistem imaji diske acilir (internet gerekmez).
 * Acilis yukleyicisi kurulur ve bilgisayar tek basina acilir.

Sure: yaklasik 5-15 dakika (diskin hizina gore).
Acilis kipi: $MOD

Kurulum boyunca her adimda ne oldugunu goreceksiniz. Iptal etmek
istediginiz anda 'Iptal' secebilirsiniz; o ana kadar diske hicbir
kalici degisiklik yapilmaz." || hata "Kurulum iptal edildi."
fi

# ------------------------------------------------- 2/6 klavye ve saat dilimi
if [ "$GUI" = "1" ] && [ "$OTO" != "1" ]; then
  KLAVYE=$(p_menu "Adim 2/6 — Klavye duzeni" \
"Kullanacaginiz klavye duzenini secin. Emin degilseniz 'Turkce Q' secin." \
    "tr" "Turkce Q (varsayilan)" \
    "trf" "Turkce F" \
    "us" "Ingilizce (US)") || hata "Kurulum iptal edildi."
  loadkeys "$KLAVYE" >/dev/null 2>&1 || true
  ZAMAN="Europe/Istanbul"
  if p_soru "Adim 2/6 — Saat dilimi" \
"Saat dilimi 'Europe/Istanbul' olarak ayarlanacak.

Farkli bir ulkedeyseniz 'Hayir' secin; sistem saati UTC olarak kalir
ve kurulum sonrasinda Ayarlar'dan degistirebilirsiniz."; then
    ZAMAN="Europe/Istanbul"
  else
    ZAMAN="UTC"
  fi
  echo "klavye: $KLAVYE, saat dilimi: $ZAMAN"
else
  KLAVYE="tr"; ZAMAN="Europe/Istanbul"
fi

# --------------------------------------------------------- 3/6 disk secimi
baslik "Kurulabilir diskler"
KAYNAK=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)
CANLI=""
if [ -n "$KAYNAK" ]; then
  CANLI=$(lsblk -ndo PKNAME "$KAYNAK" 2>/dev/null | head -1)
  [ -n "$CANLI" ] || CANLI=$(basename "$KAYNAK")
fi
DISK_LISTE=$(lsblk -bdnro NAME,SIZE,TYPE,MODEL | awk -v c="$CANLI" -v min="$MIN_BAYT" '
  $3=="disk" && $1!=c && $2>=min {
    model=""; for (i=4; i<=NF; i++) model = model (i>4 ? " " : "") $i
    if (model == "") model = "disk"
    printf "%s\t%.0f GB — %s\n", $1, $2/1000000000, model
  }')

if [ "$OTO" = "1" ]; then
  HEDEF=$(lsblk -bdnro NAME,TYPE,SIZE,RO | awk -v c="$CANLI" -v min="$MIN_BAYT" \
    '$2=="disk" && $1!=c && $3>=min && $4==0 {print $1; exit}')
  echo "Gozetimsiz kurulum hedefi: $HEDEF"
elif [ "$GUI" = "1" ]; then
  [ -n "$DISK_LISTE" ] || hata "Kurulum yapilabilecek bir disk bulunamadi (en az 8 GB gerekir). Disk kablosunu denetleyip yeniden deneyin."
  # shellcheck disable=SC2046
  OLDIFS=$IFS; IFS=$'\n\t'
  # shellcheck disable=SC2086
  HEDEF=$(p_menu "Adim 3/6 — Kurulum diski" \
"Tedbirge(R) WebOS hangi diske kurulsun?

Ok tuslariyla secin, Enter ile onaylayin. Uzerinden calistiginiz
USB bellek listede yer almaz." $DISK_LISTE) || { IFS=$OLDIFS; hata "Kurulum iptal edildi."; }
  IFS=$OLDIFS
else
  printf '%s\n' "$DISK_LISTE" | sed 's/^/  /'
  echo ""
  read -r -p "Hedef disk adi (ornek: sda) [bos = iptal]: " HEDEF
fi
[ -n "${HEDEF:-}" ] || hata "Kurulum iptal edildi."
HEDEF="${HEDEF#/dev/}"
DEV="/dev/$HEDEF"
# Ilerleme olcumu bu diskin yazma sayacini da izler (bkz. surec_ilerlemesi).
HEDEF_DISK="$HEDEF"


[ -b "$DEV" ] || hata "Boyle bir disk yok: $DEV"
[ "$HEDEF" != "$CANLI" ] || hata "Canli USB bellege kurulum yapilamaz."
BOYUT=$(blockdev --getsize64 "$DEV")
[ "$BOYUT" -ge "$MIN_BAYT" ] || hata "Disk cok kucuk (en az 8 GB gerekir)."
KIMLIK=$(lsblk -dnro MAJ:MIN "$DEV")
DISK_MODEL=$(lsblk -dnro MODEL "$DEV" 2>/dev/null | head -1)

echo ""
echo "SECILEN DISK: $DEV ($(numfmt --to=iec "$BOYUT"))"
echo "Bu diskteki her sey silinecek."
# ------------------------------------------- 4/6 silme onayi ve 5/6 ozet
# Onay artik yazi yazarak degil, Evet/Hayir dugmesiyle verilir. Eski akista
# kucuk harfle "evet" yazan kullanici sessizce bos ekrana dusuyordu.
if [ "$OTO" = "1" ]; then
  ONAY=EVET
elif [ "$GUI" = "1" ]; then
  p_soru "Adim 4/6 — DIKKAT: disk silinecek" \
"Secilen disk: $DEV
Model: ${DISK_MODEL:-bilinmiyor}
Kapasite: $(numfmt --to=iec "$BOYUT")

Bu diskteki TUM DOSYALAR, bolumler ve varsa kurulu isletim sistemi
KALICI OLARAK SILINECEK. Geri alinamaz.

Devam edilsin mi?" && ONAY=EVET || ONAY=HAYIR
else
  read -r -p "Devam etmek icin buyuk harfle EVET yazin: " ONAY
  case "$ONAY" in [Ee][Vv][Ee][Tt]) ONAY=EVET ;; esac
fi
[ "$ONAY" = "EVET" ] || hata "Kurulum iptal edildi."

[ -b "$DEV" ] || hata "Disk artik bagli degil."
[ "$(lsblk -dnro MAJ:MIN "$DEV")" = "$KIMLIK" ] || hata "Disk kimligi degisti; guvenlik icin durduruldu."

# ------------------------------------------------------------ 5/6 ozet
if [ "$GUI" = "1" ] && [ "$OTO" = "1" ]; then
  gauge_baslat
elif [ "$GUI" = "1" ]; then
  p_bilgi "Adim 5/6 — Kurulum ozeti" \
"Asagidaki islem simdi baslatilacak. Son kontrol:

 Hedef disk    : $DEV (${DISK_MODEL:-disk}, $(numfmt --to=iec "$BOYUT"))
 Acilis kipi   : $MOD
 Bolumler      : $( [ "$MOD" = "UEFI" ] && echo "EFI (512 MB) + sistem + takas" || echo "sistem + takas" )
 Klavye        : $KLAVYE
 Saat dilimi   : $ZAMAN
 Kurulum kaydi : $LOG

'Ileri' dedikten sonra disk silinir ve kurulum baslar.
Bilgisayari kapatmayin, USB bellegi cikarmayin." || hata "Kurulum iptal edildi."
  gauge_baslat
fi

# --------------------------------------------------------------- bolumleme
ILERLE 5 "Disk hazirlaniyor (bolumler olusturuluyor)"

[ "$(blockdev --getro "$DEV" 2>/dev/null || echo 1)" = "0" ] \
  || { HATA_KODU="DSK-101"; hata "Secilen disk yazmaya kapali. Diskin fiziksel yazma korumasini kapatin veya baska bir disk secin."; }
[ -b "$DEV" ] || { HATA_KODU="DSK-102"; hata "Secilen disk baglantisini kaybetti: $DEV"; }

ILERLE 6 "Diskte acik kalan bolumler kapatiliyor"
while read -r d; do
  [ -n "$d" ] || continue
  while read -r m; do
    [ -n "$m" ] || continue
    umount "$m" >>"$LOG" 2>&1 \
      || { HATA_KODU="DSK-103"; hata "$m kullanimda oldugu icin kapatilamadi. Acik dosyalari kapatip yeniden deneyin."; }
  done < <(findmnt -nr -o TARGET --source "$d" 2>/dev/null)
  swapoff "$d" >>"$LOG" 2>&1 || true
done < <(lsblk -lnpo NAME "$DEV")

YIKICI_ISLEM=1
ILERLE 8 "Eski bolum bilgileri guvenle temizleniyor"
# Yavas/ariza egilimli disklerde wipefs dakikalarca asili kalabiliyordu; artik
# ust sinirli calisir ve pencerede gecen sure gorunur.
if ! uzun_adim "Eski bolum bilgileri temizleniyor" timeout 300s wipefs -af "$DEV"; then
  HATA_KODU="DSK-104"
  hata "Eski disk bilgileri temizlenemedi. Disk kullanimda, yazmaya kapali veya baglantisi kararsiz olabilir."
fi
command -v sgdisk >/dev/null 2>&1 && timeout 300s sgdisk --zap-all "$DEV" >>"$LOG" 2>&1 || true
sync

# --- takas (swap) bolumu olcusu: derin uyku (S4) icin RAM kadar yer gerekir.
# Kucuk disklerde kurulum kilitlenmesin diye olcu dinamik kisitlanir; yer
# yetmezse takas bolumu olusturulmaz, kurulum kayit birakip devam eder.
RAM_MIB=$(awk '/^MemTotal:/ {printf "%d", ($2/1024)+1}' /proc/meminfo 2>/dev/null || echo 0)
DISK_MIB=$((BOYUT / 1048576))
SWAP_MIB=$((RAM_MIB + 256))            # hibernasyon imaji icin kucuk pay
[ "$SWAP_MIB" -gt 16384 ] && SWAP_MIB=16384
CEILING=$((DISK_MIB / 4))              # diskin en fazla dortte biri
[ "$SWAP_MIB" -gt "$CEILING" ] && SWAP_MIB="$CEILING"
KOK_ALT_SINIR=6144                     # sistem bolumune en az 6 GiB kalmali
BASLANGIC=513
[ "$MOD" = "UEFI" ] || BASLANGIC=3
if [ "$SWAP_MIB" -lt 512 ] || [ $((DISK_MIB - BASLANGIC - SWAP_MIB)) -lt "$KOK_ALT_SINIR" ]; then
  echo "! Diskte derin uyku icin yeterli yer yok; takas bolumu olusturulmuyor (RAM ${RAM_MIB} MiB, disk ${DISK_MIB} MiB)."
  SWAP_MIB=0
else
  echo "Takas bolumu: ${SWAP_MIB} MiB (RAM ${RAM_MIB} MiB) — derin uyku destegi acik."
fi
KOK_SON=$((DISK_MIB - SWAP_MIB - 1))

case "$HEDEF" in
  nvme*|mmcblk*|loop*) EK="p" ;;
  *)                   EK=""  ;;
esac

bolum_adimi() { # hata-kodu, aciklama, parted argumanlari...
  local kod="$1" aciklama="$2"; shift 2
  if ! uzun_adim "$aciklama" timeout 300s parted -s -a optimal "$DEV" "$@"; then
    HATA_KODU="$kod"
    hata "$aciklama Disk: $DEV. Ayrintili teknik neden kurulum kaydina yazildi."
  fi
}

ILERLE 10 "Yeni GPT bolum tablosu olusturuluyor"
bolum_adimi "DSK-110" "Yeni bolum tablosu olusturulamadi." mklabel gpt

if [ "$MOD" = "UEFI" ]; then
  P1="${DEV}${EK}1"; P2="${DEV}${EK}2"; P3=""
  bolum_adimi "DSK-111" "EFI acilis bolumu olusturulamadi." mkpart ESP fat32 1MiB 513MiB
  bolum_adimi "DSK-112" "EFI acilis isareti ayarlanamadi." set 1 esp on
  if [ "$SWAP_MIB" -gt 0 ]; then
    P3="${DEV}${EK}3"
    bolum_adimi "DSK-113" "Sistem bolumu olusturulamadi." mkpart tedbirge ext4 513MiB "${KOK_SON}MiB"
    bolum_adimi "DSK-114" "Takas bolumu olusturulamadi." mkpart takas linux-swap "${KOK_SON}MiB" 100%
  else
    bolum_adimi "DSK-113" "Sistem bolumu olusturulamadi." mkpart tedbirge ext4 513MiB 100%
  fi
else
  P1=""; P2="${DEV}${EK}2"; P3=""
  bolum_adimi "DSK-115" "BIOS acilis bolumu olusturulamadi." mkpart bios_grub 1MiB 3MiB
  bolum_adimi "DSK-116" "BIOS acilis isareti ayarlanamadi." set 1 bios_grub on
  if [ "$SWAP_MIB" -gt 0 ]; then
    P3="${DEV}${EK}3"
    bolum_adimi "DSK-117" "Sistem bolumu olusturulamadi." mkpart tedbirge ext4 3MiB "${KOK_SON}MiB"
    bolum_adimi "DSK-118" "Takas bolumu olusturulamadi." mkpart takas linux-swap "${KOK_SON}MiB" 100%
  else
    bolum_adimi "DSK-117" "Sistem bolumu olusturulamadi." mkpart tedbirge ext4 3MiB 100%
  fi
fi

ILERLE 12 "Yeni bolumler isletim sistemine tanitiliyor"
sync
if command -v partprobe >/dev/null 2>&1; then
  partprobe "$DEV" >>"$LOG" 2>&1 || true
fi
command -v blockdev >/dev/null 2>&1 && blockdev --rereadpt "$DEV" >>"$LOG" 2>&1 || true
command -v udevadm >/dev/null 2>&1 && udevadm trigger --action=change "$DEV" >>"$LOG" 2>&1 || true
command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=30 >>"$LOG" 2>&1 || true
BEKLE=0
while { [ -n "$P1" ] && [ ! -b "$P1" ]; } || [ ! -b "$P2" ] || { [ -n "$P3" ] && [ ! -b "$P3" ]; }; do
  [ "$BEKLE" -lt 60 ] || { HATA_KODU="DSK-120"; hata "Yeni disk bolumleri 60 saniye icinde gorulemedi. Disk kablosunu veya disk sagligini denetleyin."; }
  sleep 1; BEKLE=$((BEKLE + 1))
done

ILERLE 13 "EFI acilis bolumu bicimlendiriliyor"
if [ -n "$P1" ]; then
  uzun_adim "EFI bolumu bicimlendiriliyor" timeout 300s mkfs.vfat -F32 -n TBGEFI "$P1" \
    || { HATA_KODU="DSK-121"; hata "EFI bolumu bicimlendirilemedi."; }
fi

ILERLE 14 "Sistem bolumu bicimlendiriliyor (bu adim diske gore birkac dakika surebilir)"
# %14'te kilitlenme kok nedeni: buyuk disklerde mkfs.ext4 tum inode tablosunu
# pesin yazdigi icin dakikalarca sessiz kaliyordu. Tembel baslatma ve devre disi
# birakilan discard ile adim hizlanir; ust sinir ve canli sayac ile de ekran
# hicbir zaman "durmus" gorunmez.
uzun_adim "Sistem bolumu bicimlendiriliyor" timeout 1800s \
  mkfs.ext4 -F -q -L TEDBIRGE -E lazy_itable_init=1,lazy_journal_init=1,nodiscard "$P2" \
  || { HATA_KODU="DSK-122"; hata "Sistem bolumu bicimlendirilemedi. Diskte bir yazma veya baglanti sorunu olabilir."; }

if [ -n "$P3" ]; then
  ILERLE 14 "Takas (derin uyku) bolumu hazirlaniyor"
  if ! uzun_adim "Takas bolumu hazirlaniyor" timeout 300s mkswap -L TBGSWAP "$P3"; then
    echo "! Takas bolumu bicimlendirilemedi; derin uyku olmadan devam ediliyor."
    P3=""
  fi
fi

# ------------------------------------------------------------ sistem kopyasi
ILERLE 15 "Sistem dosyalari diske kopyalaniyor (en uzun adim, birkac dakika)"
mkdir -p "$KOK"
mount "$P2" "$KOK" || { HATA_KODU="KUR-210"; hata "Sistem bolumu baglanamadi. Disk bicimlendirildi ancak kullanima acilamadi."; }
BAGLI=1

# --- kaynak dogrulama: bozuk USB/imaj ile kopyalamaya hic baslanmaz.
# NOT: Kopyalama komutunda YALNIZCA her squashfs-tools surumunde bulunan
# secenekler kullanilir (-f, -d, -i). Surume gore degisen secenekler (surume gore degisen ilerleme secenekleri) araci yardim ekranina dusurur ve kurulum sahte "disk arizasi"
# hatasi verirdi; bu bilinen kok neden tumden kaldirilmistir.
if ! unsquashfs -s "$SQUASH" >"$LOG.kaynak" 2>&1; then
  cat "$LOG.kaynak" >>"$LOG" 2>/dev/null
  HATA_KODU="KUR-201"
  hata "Kurulum imaji okunamadi ya da bozuk. USB bellegi baska bir yuvaya takip yeniden deneyin veya imaji tekrar yazin."
fi
cat "$LOG.kaynak" >>"$LOG" 2>/dev/null
TOPLAM_DOSYA=$(awk '/Number of inodes/ {print $NF}' "$LOG.kaynak" 2>/dev/null | head -1)
KAYNAK_BAYT=$(awk '/Filesystem size/ {print $3}' "$LOG.kaynak" 2>/dev/null | head -1)
rm -f "$LOG.kaynak"
case "${TOPLAM_DOSYA:-}" in ''|*[!0-9]*) TOPLAM_DOSYA=0 ;; esac
case "${KAYNAK_BAYT:-}" in ''|*[!0-9.]*) KAYNAK_BAYT=0 ;; esac

# --- hedefte yer var mi? (sikistirilmis olcunun ~3 kati acilir)
BOS_KB=$(df -Pk "$KOK" 2>/dev/null | awk 'NR==2 {print $4}')
GEREKEN_KB=$(awk -v b="$KAYNAK_BAYT" 'BEGIN {printf "%d", (b/1024)*3}')
if [ -n "${BOS_KB:-}" ] && [ "$GEREKEN_KB" -gt 0 ] && [ "$BOS_KB" -lt "$GEREKEN_KB" ]; then
  HATA_KODU="KUR-203"
  hata "Secilen diskte sistem dosyalari icin yeterli yer yok. Daha buyuk bir disk secin."
fi

kopyalama_hatasi() { # rc
  local rc="$1"
  if [ ! -b "$DEV" ]; then
    HATA_KODU="KUR-204"
    hata "Kurulum sirasinda disk baglantisi koptu. Guc ve veri kablosunu yeniden takip kurulumu tekrarlayin."
  fi
  if ! mountpoint -q "$KOK"; then
    HATA_KODU="KUR-205"
    hata "Hedef bolum kurulum sirasinda kullanimdan dustu. Diski yeniden secip kurulumu tekrarlayin."
  fi
  if dmesg 2>/dev/null | tail -n 200 | grep -qiE "I/O error|medium error|ata[0-9]+.*failed|blk_update_request"; then
    HATA_KODU="KUR-202"
    hata "Disk yazma hatasi bildirdi. Disk saglikli olmayabilir; baska bir disk deneyin veya kabloyu degistirin."
  fi
  HATA_KODU="KUR-206"
  hata "Sistem dosyalari acilirken beklenmeyen bir hata olustu (kod $rc). Ayrintili neden kurulum kaydinda."
}

KOPYA_LOG="/var/log/tedbirge/kopya.log"
KOPYA_SAYAC="/run/tedbirge-kopya-sayac"
: > "$KOPYA_SAYAC"
# -i: acilan her ogeyi yazar. Sayaci bu ciktidan uretiriz; ilerleme boylece
# araca ozgu bir bicime degil, gercekten acilan dosya sayisina baglanir.
( unsquashfs -f -i -d "$KOK" "$SQUASH" 2>>"$LOG" \
    | stdbuf -oL awk '{n++; if (n % 200 == 0) print n}' > "$KOPYA_SAYAC"
  echo "${PIPESTATUS[0]}" > "$KOPYA_SAYAC.rc" ) &
KOPYA_PID=$!

KOPYA_BASI=$(date +%s)
SON_SAYI=0
SPIN=0
while kill -0 "$KOPYA_PID" 2>/dev/null; do
  sleep 3
  SPIN=$(((SPIN + 1) % 4))
  SIMDI=$(date +%s)
  GECEN=$((SIMDI - KOPYA_BASI))
  SAYI=$(tail -n 1 "$KOPYA_SAYAC" 2>/dev/null)
  case "${SAYI:-}" in ''|*[!0-9]*) SAYI="$SON_SAYI" ;; esac
  SON_SAYI="$SAYI"
  if [ "$TOPLAM_DOSYA" -gt 0 ]; then
    YUZ=$((15 + SAYI * 45 / TOPLAM_DOSYA))
    [ "$YUZ" -gt 60 ] && YUZ=60
  else
    YUZ=$((15 + (GECEN / 10) % 45))
  fi
  DAKIKA=$((GECEN / 60)); SANIYE=$((GECEN % 60))
  ISARET=$(printf '%s' "|/-\\" | cut -c $((SPIN + 1)))
  ILERLE "$YUZ" "Sistem dosyalari diske kopyalaniyor $ISARET — ${SAYI} dosya acildi, ${DAKIKA} dk ${SANIYE} sn"
done
wait "$KOPYA_PID" 2>/dev/null
KOPYA_RC=$(cat "$KOPYA_SAYAC.rc" 2>/dev/null || echo 1)
rm -f "$KOPYA_SAYAC" "$KOPYA_SAYAC.rc"
case "$KOPYA_RC" in ''|*[!0-9]*) KOPYA_RC=1 ;; esac
[ "$KOPYA_RC" = "0" ] || kopyalama_hatasi "$KOPYA_RC"
# Kopyalama "basarili" dedi diye guvenilmez; kurulan kok gercekten var mi?
[ -x "$KOK/usr/lib/systemd/systemd" ] || { HATA_KODU="KUR-207"; hata "Sistem dosyalari eksik kopyalandi. USB bellegi denetleyip kurulumu tekrarlayin."; }
ILERLE 60 "Sistem dosyalari diske kopyalandi"
echo "Kopyalama tamamlandi (rc=$KOPYA_RC, kayit: $KOPYA_LOG)"




if [ -n "$P1" ]; then
  mkdir -p "$KOK/boot/efi"
  mount "$P1" "$KOK/boot/efi" || hata "EFI bolumu baglanamadi."
fi
for d in dev dev/pts proc sys run; do
  mkdir -p "$KOK/$d"
  mount --rbind "/$d" "$KOK/$d" || hata "Sistem dizini baglanamadi: /$d"
  mount --make-rslave "$KOK/$d" || hata "Sistem baglama guvenligi ayarlanamadi: /$d"
done
# chroot'a girmeden once tum sanal dosya sistemleri gercekten bagli olmali;
# yarim kalan bir baglama update-initramfs/grub-install'i sessizce kilitler.
for d in dev dev/pts proc sys run; do
  mountpoint -q "$KOK/$d" || hata "Baglama dogrulanamadi: $KOK/$d"
done
# chroot icindeki paket tetikleyicileri hizmet baslatmaya kalkmasin; aksi
# halde systemd iletisim kanali kapaliyken invoke-rc.d bekleyebilir.
mkdir -p "$KOK/usr/sbin"
printf '#!/bin/sh\nexit 101\n' > "$KOK/usr/sbin/policy-rc.d"
chmod 0755 "$KOK/usr/sbin/policy-rc.d"
[ -e /etc/resolv.conf ] && cp -L /etc/resolv.conf "$KOK/etc/resolv.conf" \
  || hata "Ag cozucu ayari hedefe kopyalanamadi."

# --------------------------------------------------------------- fstab
KOK_UUID=$(blkid -s UUID -o value "$P2")
SWAP_UUID=""
[ -n "$P3" ] && SWAP_UUID=$(blkid -s UUID -o value "$P3" 2>/dev/null)
{
  echo "UUID=$KOK_UUID / ext4 errors=remount-ro,noatime 0 1"
  if [ -n "$P1" ]; then
    echo "UUID=$(blkid -s UUID -o value "$P1") /boot/efi vfat umask=0077 0 1"
  fi
  if [ -n "$SWAP_UUID" ]; then
    echo "UUID=$SWAP_UUID none swap sw 0 0"
  fi
  echo "tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0"
} > "$KOK/etc/fstab"

# Canli acilis bilesenleri kalici sistemde kapatilir.
rm -f "$KOK/etc/systemd/system/multi-user.target.wants/live-config.service" 2>/dev/null
CEKIRDEK_SATIRI="console=tty0 console=ttyS0,115200n8 quiet"
[ -n "$SWAP_UUID" ] && CEKIRDEK_SATIRI="$CEKIRDEK_SATIRI resume=UUID=$SWAP_UUID"

# /etc/default/grub anahtarlari: varsa degistirilir, yoksa eklenir. GRUB'un
# kendi ciktisi da seri porta verilir; aksi halde acilis hatasinda kayit bos
# kalir ve sorun kor noktada kalir (CI'de tam olarak bu yasandi).
grub_ayar() { # anahtar, deger
  local dosya="$KOK/etc/default/grub"
  touch "$dosya"
  if grep -q "^#\?$1=" "$dosya"; then
    sed -i "s|^#\?$1=.*|$1=$2|" "$dosya"
  else
    printf '%s=%s\n' "$1" "$2" >> "$dosya"
  fi
}
grub_ayar GRUB_CMDLINE_LINUX_DEFAULT "\"$CEKIRDEK_SATIRI\""
grub_ayar GRUB_TERMINAL "\"console serial\""
grub_ayar GRUB_SERIAL_COMMAND "\"serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1\""
grub_ayar GRUB_TIMEOUT "3"
grub_ayar GRUB_TIMEOUT_STYLE "menu"


# ------------------------------------ kalici sistem icin tasınabilir initramfs
# Kurulan sistem baska bir bilgisayara tasinabilir (disk baska makineye
# takilabilir); MODULES=dep yalniz bu donanimin suruculerini paketler ve
# tasimada acilis bozulur. MODULES=most tum yaygin denetleyicileri korur.
# Sikistirma gzip: her ortamda mevcut, dusuk CPU maliyetli ve zstd'nin
# olmadigi kurulumlarda sessiz kilitlenme uretmez.
mkdir -p "$KOK/etc/initramfs-tools/conf.d"
cat > "$KOK/etc/initramfs-tools/conf.d/tedbirge.conf" <<'EOF'
MODULES=most
COMPRESS=gzip
BUSYBOX=y
EOF
# Ana yapilandirmada baska bir sikistirma yaziyorsa onu da gzip'e cek.
if [ -f "$KOK/etc/initramfs-tools/initramfs.conf" ]; then
  if grep -q '^COMPRESS=' "$KOK/etc/initramfs-tools/initramfs.conf"; then
    sed -i 's|^COMPRESS=.*|COMPRESS=gzip|' "$KOK/etc/initramfs-tools/initramfs.conf"
  else
    echo 'COMPRESS=gzip' >> "$KOK/etc/initramfs-tools/initramfs.conf"
  fi
fi
# Derin uyku (S4) geri donusu: initramfs hangi bolumden uyanacagini bilmeli.
if [ -n "$SWAP_UUID" ]; then
  echo "RESUME=UUID=$SWAP_UUID" > "$KOK/etc/initramfs-tools/conf.d/resume"
else
  echo "RESUME=none" > "$KOK/etc/initramfs-tools/conf.d/resume"
  echo "! Takas bolumu yok; derin uyku (hibernasyon) bu kurulumda devre disi."
fi
# os-prober disk taramasi CI/emulasyon ortaminda dakikalarca surebiliyor;
# hem yapilandirmadan hem de betik iznini kaldirarak tumden engellenir.
grep -q '^GRUB_DISABLE_OS_PROBER=' "$KOK/etc/default/grub" 2>/dev/null \
  || echo 'GRUB_DISABLE_OS_PROBER=true' >> "$KOK/etc/default/grub"
[ -f "$KOK/etc/grub.d/30_os-prober" ] && chmod -x "$KOK/etc/grub.d/30_os-prober"

# ------------------------------------------------------------ acilis yukleyici
ILERLE 65 "Acilis yukleyicisi kuruluyor ($MOD)"

# --no-floppy: disket modulu yoklamasi QEMU/sanal ortamda sonsuz bekleyebilir.
if [ "$MOD" = "UEFI" ]; then
  uzun_adim "UEFI acilis yukleyicisi kuruluyor" timeout 900s chroot "$KOK" "${CHROOT_ENV[@]}" \
    grub-install --target=x86_64-efi --efi-directory=/boot/efi \
    --bootloader-id=Tedbirge --recheck --removable --no-nvram --no-floppy < /dev/null \
    || hata "UEFI acilis yukleyici kurulamadi."
else
  uzun_adim "BIOS acilis yukleyicisi kuruluyor" timeout 900s chroot "$KOK" "${CHROOT_ENV[@]}" \
    grub-install --target=i386-pc --recheck --no-floppy "$DEV" < /dev/null \
    || hata "BIOS acilis yukleyici kurulamadi."
fi
# UEFI: bazi firmware'ler yalnizca tasinabilir yolu (EFI/BOOT/BOOTX64.EFI)
# okur. grub-install --removable bunu genelde yazar; yazmadiysa elle kopyalanir.
if [ "$MOD" = "UEFI" ]; then
  if [ ! -s "$KOK/boot/efi/EFI/BOOT/BOOTX64.EFI" ]; then
    KAYNAK=$(ls "$KOK"/boot/efi/EFI/*/grubx64.efi 2>/dev/null | head -1)
    [ -n "$KAYNAK" ] || hata "UEFI acilis dosyasi (grubx64.efi) uretilmedi."
    mkdir -p "$KOK/boot/efi/EFI/BOOT"
    cp "$KAYNAK" "$KOK/boot/efi/EFI/BOOT/BOOTX64.EFI" \
      || hata "Tasinabilir UEFI acilis dosyasi olusturulamadi."
  fi
  # ESP'deki koprü menü: GRUB kendi yapilandirmasini kok bolumden okur.
  mkdir -p "$KOK/boot/efi/EFI/BOOT"
  printf 'search --no-floppy --fs-uuid --set=root %s\nset prefix=($root)/boot/grub\nconfigfile ($root)/boot/grub/grub.cfg\n' \
    "$KOK_UUID" > "$KOK/boot/efi/EFI/BOOT/grub.cfg"
fi

# ------------------------------------------------ klavye ve saat dilimi
# Kullanicinin sihirbazda verdigi cevaplar kurulan sisteme yazilir.
ILERLE 70 "Klavye ve saat dilimi ayarlaniyor"
mkdir -p "$KOK/etc/default"
cat > "$KOK/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$( [ "$KLAVYE" = "us" ] && echo us || echo tr )"
XKBVARIANT="$( [ "$KLAVYE" = "trf" ] && echo f || echo "" )"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
if [ -f "$KOK/usr/share/zoneinfo/$ZAMAN" ]; then
  ln -sf "/usr/share/zoneinfo/$ZAMAN" "$KOK/etc/localtime"
  echo "$ZAMAN" > "$KOK/etc/timezone"
fi

# Bu iki adim acilisin kendisidir; basarisiz olurlarsa kurulan sistem sessizce
