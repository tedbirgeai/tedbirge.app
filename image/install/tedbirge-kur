ILERLE 100 "Kurulum tamamlandi"
sync
temizle
BAGLI=0
sync
gauge_kapat

echo ""
echo "==============================================="
echo "  KURULUM TAMAMLANDI"
echo "==============================================="
echo "USB bellegi cikarip bilgisayari yeniden baslatin."
if [ "$OTO" = "1" ] && [ "$GUI" = "1" ]; then
  # Acilis menusunden baslatilan sifir-dokunuslu kurulum: kullanici USB'yi
  # cikarma yonergesini gorur, sayac biter ve sistem diskten acilir.
  touch /run/tedbirge-installer-complete
  for t in /dev/console /dev/ttyS0; do printf 'TEDBIRGE_INSTALL_OK\n' > "$t" 2>/dev/null; done
  GERI=20
  while [ "$GERI" -gt 0 ]; do
    whiptail --backtitle "$BT" --title "Kurulum tamamlandi" \
      --infobox "Tedbirge(R) WebOS $DEV diskine basariyla kuruldu.

SIMDI YAPMANIZ GEREKEN:
 1) USB bellegi bilgisayardan CIKARIN.
