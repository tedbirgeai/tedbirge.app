# Tedbirge(R) WebOS — ORTAK paket listesi (her iki surumde de kurulur).
# Bu liste DERLEME sırasında kurulur ve squashfs içine pişirilir.
# Kullanıcı bilgisayarında açılışta hiçbir paket kurulmaz.
# Profil secimi image/build.sh tarafindan yapilir; bu dosya dogrudan
# live-build tarafindan okunmaz (config/package-lists altina kopyalanir).

# --- canlı açılış altyapısı
live-boot
live-config
live-config-systemd
systemd-sysv

# --- çekirdek (bookworm-backports: yeni Intel/AMD/Nvidia donanim icin sart)
linux-image-amd64/bookworm-backports
intel-microcode
amd64-microcode

# --- donanim yazilimlari (temel kapsamli firmware seti)
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-sof-signed
firmware-atheros
firmware-amd-graphics

# --- kurumsal acilis/kapanis ekrani (Plymouth)
plymouth
plymouth-themes
plymouth-label

# --- grafik yığını
xserver-xorg
xserver-xorg-input-libinput
xserver-xorg-video-all
xinit
x11-xserver-utils
libgl1-mesa-dri
mesa-vulkan-drivers
mesa-utils
libvulkan1
vulkan-tools
libva2
va-driver-all
vdpau-driver-all
fonts-dejavu-core
# Kurulum sihirbazi: pencereli metin arayuzu, klavye, konsol duzeni ve
# konsol fare destegi (gpm) — kurulum ekranlari fare ile de kullanilabilir.
whiptail
console-setup
kbd
keyboard-configuration
gpm

brightnessctl

# --- arayüz
chromium
nginx-light

# --- ağ (kablolu + kablosuz + mobil genis bant)
network-manager
wpasupplicant
wireless-tools
wireless-regdb
iw
ethtool
rfkill
bluez
modemmanager
libmbim-utils
libqmi-utils
usb-modeswitch
usb-modeswitch-data

# --- ses (SOF dahil; PipeWire + Bluetooth kulaklik profilleri)
pipewire
pipewire-pulse
wireplumber
alsa-utils
alsa-ucm-conf
libasound2-plugins
libspa-0.2-bluetooth

# --- depolama ve kurulum araçları
parted
gdisk
dosfstools
e2fsprogs
f2fs-tools
exfatprogs
ntfs-3g
util-linux
nvme-cli
mmc-utils
hdparm
sdparm
smartmontools
mdadm
squashfs-tools
zstd
rsync
grub-pc-bin
grub-efi-amd64-bin
grub2-common
efibootmgr
os-prober
udisks2
bolt

# --- kamera (UVC web kameralari) ve firmware guncelleme
v4l-utils
libv4l-0
fwupd

# --- güç ve pil (pil gostergesi upower uzerinden okunur)
upower
acpid
acpi
policykit-1

# --- sistem
zram-tools
dbus-x11
curl
netcat-openbsd
ca-certificates
less
nano
pciutils
usbutils
logrotate
