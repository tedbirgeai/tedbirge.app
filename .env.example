# Tedbirge Protocol — ortam değişkeni şablonu
# Bu dosya örnektir; gerçek değerler .env / .env.development / .env.production
# dosyalarında tutulur ve depoya işlenmez.

# Lovable Cloud (backend) — yayınlanabilir anahtarlar
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Paddle ödeme istemci belirteci (test için test_, canlı için live_ ön eki)
VITE_PAYMENTS_CLIENT_TOKEN=

# Hazır bare-metal imaj adresi (GitHub Release / CDN).
# Tanımlıysa ISO indirme akışı doğrudan bu dosyayı indirir;
# boşsa arayüz PWA kurulumu + yerel derleme rehberi sunar.
VITE_ISO_DOWNLOAD_URL=
